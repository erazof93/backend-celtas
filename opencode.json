{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
 
  // Modelo por defecto para TODOS los agentes primarios (celtas-backend, build, plan, etc.)
  // Los subagentes (ej. tester) heredan el modelo del agente primario que los invoca,
  // así que basta con cambiar esta línea cuando quieran probar otro modelo.
  "model": "openrouter/deepseek/deepseek-v4-flash:free",
 
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "pnpm dlx *": "allow",
      "docker compose *": "allow",
      "nest *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}