# Copia este archivo a .env y ajusta los valores según tu entorno.
# docker-compose.yml lee DB_USERNAME / DB_PASSWORD / DB_DATABASE automáticamente desde .env

# App
PORT=3000
NODE_ENV=development

# Base de datos (usadas por docker-compose.yml y por TypeORM vía ConfigService)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_DATABASE=celtas_db

# Auth (se usan a partir del módulo 1 - Auth)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_tambien_por_otro_secreto
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (se agrega cuando lleguemos al módulo de Auth)
# GOOGLE_CLIENT_ID=