# Copia este archivo a .env y ajusta los valores según tu entorno.
# docker-compose.yml lee DB_USERNAME / DB_PASSWORD / DB_DATABASE automáticamente desde .env

# App
PORT=3000
NODE_ENV=development

# Base de datos (usadas por docker-compose.yml y por TypeORM vía ConfigService)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=admin
DB_DATABASE=celtas_db

# Auth (se usan a partir del módulo 1 - Auth)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_random
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_esto_tambien_por_otro_secreto
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (login con Google)
# Se consigue en Google Cloud Console > Credentials > OAuth 2.0 Client ID (aplicación web).
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com

# WhatsApp (link de confirmación de pedidos)
# Número de negocio en formato internacional sin "+" ni espacios (ej. 51999999999).
# OPCIONAL: el número vive en la tabla `settings` (key whatsapp_business_number, se
# gestiona desde el panel admin). Este valor solo se usa como fallback si la tabla
# está vacía (despliegue sin sembrar).
WHATSAPP_BUSINESS_NUMBER=51999999999

# Cloudinary (subida de imágenes del menú)
# Se consiguen en Cloudinary Console > Dashboard > Account Details.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Cupones automáticos (módulo Coupons)
# Monto acumulado (en soles) que dispara la generación de un cupón automático.
COUPON_THRESHOLD_AMOUNT=50
# Días de validez de un cupón desde su generación.
COUPON_EXPIRATION_DAYS=15

# Firebase Cloud Messaging (módulo Notifications)
# Service account de Firebase: Project Settings > Service accounts > Generate new private key.
# FIREBASE_PRIVATE_KEY debe ir entre comillas dobles y con \n literales (así lo exporta Firebase).
FIREBASE_PROJECT_ID=tu_project_id_de_firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"